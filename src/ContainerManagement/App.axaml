<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ContainerManagement"
             xmlns:views="using:ContainerManagement.Views"
             x:Class="ContainerManagement.App"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <views:AmountWordsConverter x:Key="WordsConv" />
    <views:MoneyTextConverter x:Key="MoneyConv" />
    <SolidColorBrush x:Key="NavyBrush">#1B2A4A</SolidColorBrush>
    <SolidColorBrush x:Key="NavySoftBrush">#243656</SolidColorBrush>
    <SolidColorBrush x:Key="GoldBrush">#C9A227</SolidColorBrush>
    <SolidColorBrush x:Key="PageBrush">#F4F3EF</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#6B7280</SolidColorBrush>
    <SolidColorBrush x:Key="OkBrush">#157A3F</SolidColorBrush>
    <SolidColorBrush x:Key="BadBrush">#B42318</SolidColorBrush>
    <SolidColorBrush x:Key="LineBrush">#E6E4DE</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbFill">#661B2A4A</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver">#991B2A4A</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed">#CC1B2A4A</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground">#661B2A4A</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackFill">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackFillPressed">Transparent</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, San Francisco, sans-serif" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#1B2A4A" />
      <Setter Property="Background" Value="{StaticResource PageBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1B2A4A" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1B2A4A" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!--  The live "this is 15 lac" line under an amount box. Pulled up into the box's own bottom
          margin so it reads as part of the field, not as a new row.  -->
    <Style Selector="TextBlock.words">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
      <Setter Property="Margin" Value="0,-6,0,6" />
    </Style>
    <!--  The maker's mark, typeset. Inter because the wordmark is geometric; LetterSpacing counts
          device-independent pixels, so the tracking is written per size instead of as an em. The
          on-dark pair only exists so the same plate can sit on the navy rail, where navy ink would be
          invisible; two classes on the selector keeps it winning over the plain one on purpose rather
          than by the order the styles happen to be declared in.  -->
    <Style Selector="TextBlock.brand">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="3" />
      <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
    </Style>
    <Style Selector="TextBlock.brandTag">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="LetterSpacing" Value="4" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.brand.brandOnDark">
      <Setter Property="Foreground" Value="#F2FFFFFF" />
    </Style>
    <Style Selector="TextBlock.brandTag.brandTagOnDark">
      <Setter Property="Foreground" Value="#80FFFFFF" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.stat">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1B2A4A" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource NavyBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#243656" />
    </Style>
    <Style Selector="Button.gold">
      <Setter Property="Background" Value="{StaticResource GoldBrush}" />
      <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.gold:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#D4B03A" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="22,20" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #14000000" />
    </Style>
    <Style Selector="Border.statcard">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,12,16" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #14000000" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="28,24" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #33000000" />
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserResizeColumns" Value="True" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="RowHeight" Value="44" />
      <Setter Property="MinHeight" Value="140" />
      <Setter Property="MaxHeight" Value="348" />
    </Style>
    <Style Selector="DataGrid.tall">
      <Setter Property="MaxHeight" Value="10000" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#6B7280" />
      <Setter Property="Background" Value="#F7F6F2" />
      <Setter Property="Padding" Value="10,10" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown, DatePicker, AutoCompleteBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="FormatString" Value="#,##0.##" />
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="AllowAutoHide" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="6" />
      <Setter Property="MinWidth" Value="6" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
    </Style>
    <Style Selector="ScrollBar Thumb">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
