<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.BuyPlansView"
             x:DataType="vm:BuyPlansViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="h1" Text="Order sheets" />
      <Button Grid.Column="1" Classes="gold" Content="New sheet" Command="{Binding BeginAddCommand}"
              IsVisible="{Binding !ShowAddForm}" VerticalAlignment="Top" Margin="16,0,0,0" />
    </Grid>

    <Border Classes="card">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Classes="h2" Text="Sheets" Margin="0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding HasSelection}" Margin="16,0,0,0">
            <Button Content="Open" Command="{Binding OpenCommand}" />
            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" IsVisible="{Binding IsOwner}" />
            <CheckBox Content="Delete for good" IsChecked="{Binding ConfirmDelete}" VerticalAlignment="Center"
                      IsVisible="{Binding IsOwner}" />
            <Button Classes="danger" Content="Delete" Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding ConfirmDelete}" IsVisible="{Binding IsOwner}" />
          </StackPanel>
        </Grid>

        <DataGrid Classes="tall" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  DoubleTapped="OnDoubleTap" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Sheet" Binding="{Binding TitleText}" Width="*" />
            <DataGridTextColumn Header="Rows" Binding="{Binding ItemCountText}" Width="90" />
            <DataGridTextColumn Header="Cost ¥" Binding="{Binding CostYenText}" Width="140" />
            <DataGridTextColumn Header="Cost Rs" Binding="{Binding CostPkrText}" Width="150" />
            <DataGridTextColumn Header="Expense" Binding="{Binding ExpenseText}" Width="150" />
            <DataGridTextColumn Header="Sells for" Binding="{Binding SaleText}" Width="160" />
            <DataGridTemplateColumn Header="Profit" Width="160">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ProfitText}" Margin="10,0" VerticalAlignment="Center"
                             FontWeight="SemiBold"
                             Classes.ok="{Binding ProfitIsGood}" Classes.bad="{Binding !ProfitIsGood}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Made" Binding="{Binding CreatedText}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Classes="muted" Margin="0,12,0,0" Text="Double-click to open." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowAddForm}" Padding="22,16">
      <Grid ColumnDefinitions="*,Auto" Width="620" HorizontalAlignment="Left">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Classes="label" Text="NAME" />
          <TextBox Text="{Binding NewTitle}" Watermark="e.g. April — Yiwu electronics" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button Classes="primary" Content="Create" Command="{Binding CreateCommand}" />
          <Button Content="Cancel" Command="{Binding CancelAddCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
