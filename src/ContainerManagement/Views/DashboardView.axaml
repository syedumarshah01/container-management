<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="h1" Text="Home" Margin="0,0,0,4" />
        <TextBlock Classes="muted" Text="{Binding Hint}" Margin="0,0,0,16" />
      </StackPanel>
      <Button Grid.Column="1" Classes="gold" Content="Sell" Command="{Binding GoNewSaleCommand}"
              VerticalAlignment="Top" Margin="16,0,0,0" />
    </Grid>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="This month" />
        <Grid ColumnDefinitions="*,*">
          <StackPanel Margin="0,0,16,0">
            <TextBlock Classes="label" Text="Total sales" />
            <TextBlock Classes="stat" Text="{Binding MonthSales}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="Total profit" />
            <TextBlock Classes="stat ok" Text="{Binding MonthProfit}" />
            <TextBlock Classes="muted" FontSize="12" Margin="0,6,0,0"
                       Text="Sales profit minus this month’s expense ledger." />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Daily summary" />
        <DataGrid ItemsSource="{Binding Days}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="140" />
            <DataGridTextColumn Header="Sales" Binding="{Binding SalesText}" Width="*" />
            <DataGridTextColumn Header="Profit" Binding="{Binding ProfitText}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="statcard" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Classes="label" Text="Last backup" />
        <TextBlock Classes="stat" FontSize="18" Text="{Binding LastBackup}" TextWrapping="Wrap" />
        <Button Content="Backup" Command="{Binding GoBackupCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
