<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="h1" Text="Home" Margin="0,0,0,4" />
        <TextBlock Classes="muted" Text="{Binding Hint}" Margin="0,0,0,16" />
      </StackPanel>
      <Button Grid.Column="1" Classes="gold" Content="Sell" Command="{Binding GoNewSaleCommand}"
              VerticalAlignment="Top" Margin="16,0,0,0" />
    </Grid>

    <Border Classes="card">
      <Grid ColumnDefinitions="*,*,Auto">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Classes="label" Text="From" />
          <DatePicker SelectedDate="{Binding FromDate}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,8,0">
          <TextBlock Classes="label" Text="To" />
          <DatePicker SelectedDate="{Binding ToDate}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="primary" Content="Apply" Command="{Binding ApplyCommand}"
                VerticalAlignment="Bottom" Margin="0,0,0,12" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,*,*">
      <Border Classes="statcard" Margin="0,0,8,16">
        <StackPanel>
          <TextBlock Classes="label" Text="Total valuation" />
          <TextBlock Classes="stat" Text="{Binding InventoryValue}" />
        </StackPanel>
      </Border>
      <Border Classes="statcard" Grid.Column="1" Margin="8,0,8,16">
        <StackPanel>
          <TextBlock Classes="label" Text="Total sale" />
          <TextBlock Classes="stat" Text="{Binding TotalSale}" />
        </StackPanel>
      </Border>
      <Border Classes="statcard" Grid.Column="2" Margin="8,0,0,16">
        <StackPanel>
          <TextBlock Classes="label" Text="{Binding ProfitLabel}" />
          <TextBlock Classes="stat ok" Text="{Binding TotalProfit}" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Classes="h2" Text="Needs attention" />
    <Grid ColumnDefinitions="*,*,*">
      <Border Classes="statcard" Margin="0,0,8,16">
        <StackPanel>
          <TextBlock Classes="label" Text="Low stock" />
          <TextBlock Classes="stat" Text="{Binding LowStockCount}" />
          <Button Content="Stock" Command="{Binding GoStockCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
      <Border Classes="statcard" Grid.Column="1" Margin="8,0,8,16">
        <StackPanel>
          <TextBlock Classes="label" Text="Unpaid bills" />
          <TextBlock Classes="stat" Text="{Binding UnpaidCount}" />
          <TextBlock Classes="muted" Text="{Binding UnpaidTotal}" Margin="0,8,0,0" />
          <Button Content="To collect" Command="{Binding GoCollectCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
      <Border Classes="statcard" Grid.Column="2" Margin="8,0,0,16">
        <StackPanel>
          <TextBlock Classes="label" Text="Last backup" />
          <TextBlock Classes="stat" FontSize="18" Text="{Binding LastBackup}" TextWrapping="Wrap" />
          <Button Content="Backup" Command="{Binding GoBackupCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Low stock" />
        <DataGrid ItemsSource="{Binding LowStock}" SelectedItem="{Binding SelectedLowStock}"
                  x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" />
            <DataGridTextColumn Header="SKU" Binding="{Binding SkuText}" Width="90" />
            <DataGridTextColumn Header="In Stock" Binding="{Binding InStockText}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Unpaid bills" />
        <DataGrid ItemsSource="{Binding Unpaid}" SelectedItem="{Binding SelectedUnpaid}"
                  DoubleTapped="OnUnpaidDoubleTap" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Bill" Binding="{Binding BillText}" Width="80" />
            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="120" />
            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
            <DataGridTextColumn Header="Left" Binding="{Binding RemainingText}" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
