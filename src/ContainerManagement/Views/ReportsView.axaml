<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">
  <UserControl.Styles>
    <!--  A year's table has a total at its foot, and a total that looks like a thirteenth month is read as
          one. The band runs edge to edge because the cell's own padding is pulled back with a negative margin,
          so the tint does not break into chips between the columns. -->
    <Style Selector="Border.Tint">
      <Setter Property="Background" Value="{StaticResource LineBrush}" />
    </Style>
    <Style Selector="TextBlock.Bold">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel>

    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Reports" Margin="0" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Print" Command="{Binding PrintCommand}" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="Excel / CSV" Command="{Binding ExportCommand}" Margin="12,0,0,0"
              VerticalAlignment="Center" IsVisible="{Binding ShowExport}" />
    </Grid>

    <!-- The list of reports is the page: what you are not looking at is not shown, and the dates only appear
         beside the reports that can be read over them. A control that cannot change what is under it is a
         control that teaches the shop to ignore it. -->
    <Grid ColumnDefinitions="260,Auto,Auto,Auto,*" Margin="0,0,0,16">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Classes="label" Text="Report" />
        <ComboBox ItemsSource="{Binding ReportChoices}" SelectedItem="{Binding SelectedReport}" MinWidth="240" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0"
                  VerticalAlignment="Bottom" IsVisible="{Binding ShowRange}">
        <TextBlock Classes="label" Text="From" VerticalAlignment="Center" />
        <DatePicker SelectedDate="{Binding FromDate}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0"
                  VerticalAlignment="Bottom" IsVisible="{Binding ShowRange}">
        <TextBlock Classes="label" Text="To" VerticalAlignment="Center" />
        <DatePicker SelectedDate="{Binding ToDate}" VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="3" Classes="primary" Content="Apply" Command="{Binding ApplyCommand}"
              IsVisible="{Binding ShowRange}" Margin="0,0,8,0" VerticalAlignment="Bottom" />
      <!-- The reset belongs with the dates and only while there are some: a report already reading what the
           reset would put back does not need a button saying so, and its label names where it lands - this
           month, this year, or the whole book. -->
      <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" IsVisible="{Binding ShowRange}">
        <Button Content="{Binding ResetLabel}" Command="{Binding ClearRangeCommand}" IsVisible="{Binding HasRange}" />
      </StackPanel>
    </Grid>

    <Border Classes="card" IsVisible="{Binding ShowBook}">
      <StackPanel>
        <TextBlock Classes="h2" Text="The book, as it stands today" />
        <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Classes="label" Text="Sold" />
            <TextBlock Classes="stat" Text="{Binding BookRevenue}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="Profit" />
            <TextBlock Classes="stat ok" Text="{Binding BookProfit}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Still in the market" />
            <TextBlock Classes="stat" Text="{Binding BookInMarket}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="label" Text="Stock on the shelf" />
            <TextBlock Classes="stat" Text="{Binding BookStock}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="label" Text="Containers" />
            <TextBlock Classes="stat" Text="{Binding BookContainers}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowPeriod}">
      <StackPanel>
        <TextBlock Classes="h2" Text="{Binding PeriodLabel}" />
        <Grid ColumnDefinitions="*,*,*,*" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Classes="label" Text="Sold" />
            <TextBlock Classes="stat" Text="{Binding PeriodRevenue}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="Profit" />
            <TextBlock Classes="stat ok" Text="{Binding PeriodProfit}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Still in the market" />
            <TextBlock Classes="stat" Text="{Binding PeriodInMarket}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="label" Text="Containers that landed" />
            <TextBlock Classes="stat" Text="{Binding PeriodContainers}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowTill}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Main ledger" Margin="0,0,0,2" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding YearLabel}" Margin="0,0,0,12" />
        <Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="label" Text="In" />
            <TextBlock Classes="stat ok" Text="{Binding TillIn}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="Out" />
            <TextBlock Classes="stat" Text="{Binding TillOut}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Returns" />
            <TextBlock Classes="stat" Text="{Binding TillReturns}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="label" Text="Cash at the year's end" />
            <TextBlock Classes="stat" Text="{Binding TillClosing}" />
          </StackPanel>
        </Grid>
        <DataGrid ItemsSource="{Binding TillRows}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Month" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding MonthText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="In" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding InText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Out" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding OutText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Returns" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding ReturnsText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Cash at the month's end" Width="170">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding ClosingText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowSales}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Sales" Margin="0,0,0,2" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding YearLabel}" Margin="0,0,0,12" />
        <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="label" Text="Bills" />
            <TextBlock Classes="stat" Text="{Binding YearBills}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="Sold" />
            <TextBlock Classes="stat" Text="{Binding YearSold}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Received" />
            <TextBlock Classes="stat" Text="{Binding YearReceived}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="label" Text="Still owed" />
            <TextBlock Classes="stat" Text="{Binding YearStillOwed}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="label" Text="Profit" />
            <TextBlock Classes="stat ok" Text="{Binding YearProfit}" />
          </StackPanel>
        </Grid>
        <DataGrid ItemsSource="{Binding SalesRows}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Month" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding MonthText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Bills" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding BillsText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Sold" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding SoldText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Received" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding ReceivedText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Still owed" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding StillOwedText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Profit" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding ProfitText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowBills}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Expenses" Margin="0,0,0,2" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding YearLabel}" Margin="0,0,0,12" />
        <Grid ColumnDefinitions="*,*" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="label" Text="Lines" />
            <TextBlock Classes="stat" Text="{Binding BillCount}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="Money" />
            <TextBlock Classes="stat" Text="{Binding BillAmount}" />
          </StackPanel>
        </Grid>
        <DataGrid ItemsSource="{Binding BillRows}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Month" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding MonthText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Lines" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding CountText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Money" Width="170">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Classes.Tint="{Binding Tint}" Margin="-10,0" Padding="10,0">
                    <TextBlock Classes.Bold="{Binding Bold}" Text="{Binding AmountText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowContainers}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Containers" Margin="0,0,0,2" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding PeriodLabel}" Margin="0,0,0,12" />
        <DataGrid ItemsSource="{Binding Containers}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Container" Binding="{Binding Title}" Width="*" />
            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110" />
            <DataGridTextColumn Header="Sold" Binding="{Binding RevenueText}" Width="160" />
            <DataGridTextColumn Header="Profit" Binding="{Binding ProfitText}" Width="160" />
            <DataGridTextColumn Header="Still in the market" Binding="{Binding InMarketText}" Width="170" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Classes="muted" FontSize="12" Text="{Binding ListNote}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowWhoOwes}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Who owes" />
        <DataGrid ItemsSource="{Binding WhoOwes}" x:CompileBindings="False" Margin="0,10,0,0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Owes" Binding="{Binding BalanceText}" Width="160" />
            <DataGridTextColumn Header="Oldest bill" Binding="{Binding OldestDueText}" Width="130" />
            <DataGridTextColumn Header="How long" Binding="{Binding Aging}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Classes="muted" FontSize="12" Text="{Binding ListNote}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowStock}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Stock" />
        <DataGrid ItemsSource="{Binding Stock}" x:CompileBindings="False" Margin="0,10,0,0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" />
            <DataGridTextColumn Header="In stock" Binding="{Binding InStockText}" Width="130" />
            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="160" />
            <DataGridTextColumn Header="From" Binding="{Binding LotsText}" Width="200" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Classes="muted" FontSize="12" Text="{Binding ListNote}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowItems}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Profit by item" Margin="0,0,0,2" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding PeriodLabel}" Margin="0,0,0,12" />
        <DataGrid ItemsSource="{Binding Items}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" />
            <DataGridTextColumn Header="Sold" Binding="{Binding QtyText}" Width="110" />
            <DataGridTextColumn Header="Amount" Binding="{Binding RevenueText}" Width="160" />
            <DataGridTextColumn Header="Profit" Binding="{Binding ProfitText}" Width="160" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Classes="muted" FontSize="12" Text="{Binding ListNote}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
