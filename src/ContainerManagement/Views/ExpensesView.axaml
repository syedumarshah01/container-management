<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.ExpensesView"
             x:DataType="vm:ExpensesViewModel">
  <UserControl.Styles>
    <Style Selector="DataGrid ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Expenses" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,16">
      <Border Classes="statcard" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Classes="label" Text="This month" />
          <TextBlock Classes="stat" Text="{Binding MonthTotal}" />
        </StackPanel>
      </Border>
      <Border Classes="statcard" Grid.Column="1" Margin="8,0,0,0">
        <StackPanel>
          <TextBlock Classes="label" Text="All time" />
          <TextBlock Classes="stat" Text="{Binding AllTotal}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border DockPanel.Dock="Top" Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Add a daily expense" />
        <Grid ColumnDefinitions="180,*,140">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Classes="label" Text="Date" />
            <DatePicker SelectedDate="{Binding SpendDate}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <TextBlock Classes="label" Text="What" />
            <TextBox Text="{Binding What}" Watermark="Rent, electricity, tea…" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Amount (Rs)" />
            <NumericUpDown Value="{Binding Amount}" Minimum="0" />
          </StackPanel>
        </Grid>
        <TextBlock Classes="label" Text="Note (optional)" />
        <TextBox Text="{Binding Notes}" Watermark="optional" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Add" Command="{Binding AddCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" />
          <Button Classes="danger" Content="Remove" Command="{Binding RemoveCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Margin="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Ledger" />
        <DataGrid Classes="tall" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  VerticalScrollBarVisibility="Visible" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110" />
            <DataGridTextColumn Header="What" Binding="{Binding Description}" Width="*" />
            <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="160" />
            <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="130" />
            <DataGridTextColumn Header="Total so far" Binding="{Binding RunningText}" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
