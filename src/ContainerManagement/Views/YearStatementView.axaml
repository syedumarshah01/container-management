<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.YearStatementView"
             x:DataType="vm:YearStatementViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="Year statement" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="label" Text="After costs" />
        <TextBlock Classes="stat" Text="{Binding AfterCosts}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" MinWidth="120" />
        <Button Classes="primary" Content="Print" Command="{Binding PrintCommand}" />
      </StackPanel>
    </Grid>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Main ledger" />
        <DataGrid ItemsSource="{Binding Till}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Month" Binding="{Binding MonthText}" Width="120" />
            <DataGridTextColumn Header="In" Binding="{Binding InText}" Width="150" />
            <DataGridTextColumn Header="Out" Binding="{Binding OutText}" Width="150" />
            <DataGridTextColumn Header="Net" Binding="{Binding NetText}" Width="150" />
            <DataGridTextColumn Header="Goods back" Binding="{Binding ReturnsText}" Width="160" />
            <DataGridTextColumn Header="Closing" Binding="{Binding ClosingText}" Width="160" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Sales" />
        <DataGrid ItemsSource="{Binding Sales}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Month" Binding="{Binding MonthText}" Width="120" />
            <DataGridTextColumn Header="Bills" Binding="{Binding BillsText}" Width="90" />
            <DataGridTextColumn Header="Sold" Binding="{Binding SoldText}" Width="160" />
            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" Width="160" />
            <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedText}" Width="160" />
            <DataGridTextColumn Header="Still owed" Binding="{Binding StillOwedText}" Width="160" />
            <DataGridTextColumn Header="Profit" Binding="{Binding ProfitText}" Width="160" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Shop costs" />
        <DataGrid ItemsSource="{Binding Costs}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Month" Binding="{Binding MonthText}" Width="120" />
            <DataGridTextColumn Header="Lines" Binding="{Binding CountText}" Width="90" />
            <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="160" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
