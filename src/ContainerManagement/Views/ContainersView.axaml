<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.ContainersView"
             x:DataType="vm:ContainersViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Containers" Margin="0" VerticalAlignment="Center" />
      <!-- The paper belongs with the button that opens the day, not off on its own: print is what you do with
           the list you are already looking at. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Print" Command="{Binding PrintCommand}" />
        <Button Classes="gold" Content="Add container" Command="{Binding BeginAddCommand}"
                IsVisible="{Binding !ShowAddForm}" />
      </StackPanel>
    </Grid>

    <Border Classes="card">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Classes="h2" Text="All containers" Margin="0" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Query}" Watermark="Search name, number, origin, date"
                   Width="300" VerticalAlignment="Center" />
        </Grid>
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  DoubleTapped="OnDoubleTap" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
            <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="140" />
            <DataGridTextColumn Header="Arrival" Binding="{Binding ArrivalText}" Width="120" />
            <DataGridTextColumn Header="Stock" Binding="{Binding RemainingValueText}" Width="140" />
            <DataGridTextColumn Header="Profit" Binding="{Binding ProfitText}" Width="140" />
            <DataGridTextColumn Header="Collected" Binding="{Binding CollectedText}" Width="150" />
            <DataGridTextColumn Header="In the market" Binding="{Binding InMarketText}" Width="150" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowAddForm}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Add a container" />
        <TextBlock Classes="label" Text="Title" />
        <TextBox Text="{Binding NewTitle}" Watermark="e.g. Yiwu electronics — March" />
        <Grid ColumnDefinitions="*,*,Auto">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Classes="label" Text="Container number" />
            <TextBox Text="{Binding NewNumber}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <TextBlock Classes="label" Text="Origin" />
            <TextBox Text="{Binding NewOrigin}" />
          </StackPanel>
          <!-- The cell is Auto and the picker is not stretched, so the column is exactly as wide as the
               control asks for: nothing here can clip it, whatever the theme decides a date box needs. -->
          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <TextBlock Classes="label" Text="Arrived on" HorizontalAlignment="Right" />
            <DatePicker SelectedDate="{Binding NewArrival}" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="2*,*,*,180">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Classes="label" Text="Supplier in China" />
            <TextBox Text="{Binding NewSupplier}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <TextBlock Classes="label" Text="We owe them (Rs)" />
            <NumericUpDown Value="{Binding NewSupplierAmount}" Minimum="0" />
            <TextBlock Classes="words" Text="{Binding NewSupplierAmount, Converter={StaticResource WordsConv}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,8,0">
            <TextBlock Classes="label" Text="Paid now (Rs)" />
            <NumericUpDown Value="{Binding NewPaid}" Minimum="0" />
            <TextBlock Classes="words" Text="{Binding NewPaid, Converter={StaticResource WordsConv}}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="label" Text="Paid by" />
            <ComboBox ItemsSource="{Binding PaidMethods}" SelectedItem="{Binding NewPaidMethod}" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,*,*">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Classes="label" Text="Cartons (optional)" />
            <NumericUpDown Value="{Binding NewCartons}" Minimum="0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <TextBlock Classes="label" Text="CBM (optional)" />
            <NumericUpDown Value="{Binding NewCbm}" Minimum="0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Weight kg (optional)" />
            <NumericUpDown Value="{Binding NewWeight}" Minimum="0" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Create" Command="{Binding CreateCommand}" />
          <Button Content="Cancel" Command="{Binding CancelAddCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
