<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.ContainerDetailView"
             x:DataType="vm:ContainerDetailViewModel">
  <UserControl.Styles>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="DataGrid ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" Classes="page"
                AllowAutoHide="False"
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Grid x:Name="MainPane" RowDefinitions="Auto,Auto,Auto,Auto">
        <DockPanel LastChildFill="True" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0"
                      VerticalAlignment="Top">
            <Button Content="Back" Command="{Binding BackCommand}" />
            <Button Content="Close / re-open" Command="{Binding ToggleCloseCommand}" />
            <Button Classes="gold" Content="Sell" Command="{Binding SellFromHereCommand}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,16">
          <Border Classes="statcard" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Classes="label" Text="Valuation" />
              <TextBlock Classes="stat" Text="{Binding StockValue}" />
            </StackPanel>
          </Border>
          <Border Classes="statcard" Grid.Column="1" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Classes="label" Text="Stock sold" />
              <TextBlock Classes="stat" Text="{Binding StockSold}" />
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Grid.Row="2">
          <Button Content="Edit import details" Command="{Binding ToggleImportCommand}"
                  HorizontalAlignment="Left" Margin="0,0,0,16" />
          <Border Classes="card" IsVisible="{Binding ShowImportEditor}">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Import details" />

              <Grid ColumnDefinitions="110,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Classes="label" Text="Supplier" VerticalAlignment="Center" Margin="0" />
                <TextBox Grid.Column="1" Width="460" Margin="0,6" Text="{Binding EditSupplier}"
                         Watermark="as on the invoice" />

                <TextBlock Grid.Row="1" Classes="label" Text="We owe (Rs)" VerticalAlignment="Center" Margin="0" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Width="260" Margin="0,6" Minimum="0"
                               ShowButtonSpinner="False" AllowSpin="False"
                               Value="{Binding EditSupplierAmount}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="words" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="{Binding EditSupplierAmount, Converter={StaticResource WordsConv}}" />

                <TextBlock Grid.Row="2" Classes="label" Text="Paid (Rs)" VerticalAlignment="Center" Margin="0" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Width="260" Margin="0,6" Minimum="0"
                               ShowButtonSpinner="False" AllowSpin="False"
                               Value="{Binding EditPaidSoFar}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Classes="words" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="{Binding EditPaidSoFar, Converter={StaticResource WordsConv}}" />

                <TextBlock Grid.Row="3" Classes="label" Text="Weight (kg)" VerticalAlignment="Center" Margin="0" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Width="140" Margin="0,6" Minimum="0"
                               Value="{Binding EditWeight}" />

                <TextBlock Grid.Row="4" Classes="label" Text="Arrived on" VerticalAlignment="Center" Margin="0" />
                <DatePicker Grid.Row="4" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left"
                            SelectedDate="{Binding EditArrival}" />

                <!-- Expenses written in yen are turned into rupees at this rate and the rate is kept on the
                     line, so a rate changed later does not re-value money already paid. Leave it empty and a
                     yen expense is refused rather than read as rupees. -->
                <TextBlock Grid.Row="5" Classes="label" Text="Rs for 1 yen" VerticalAlignment="Center" Margin="0" />
                <NumericUpDown Grid.Row="5" Grid.Column="1" Width="140" Margin="0,6" Minimum="0"
                               Increment="0.01" FormatString="#,##0.####" Value="{Binding EditYenRate}" />
              </Grid>

              <TextBlock Classes="label" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                         IsVisible="{Binding ShowBillHint}" Text="{Binding EditBillHint}" Margin="0,0,0,10" />

              <Button Classes="primary" Content="Save" Command="{Binding SaveDetailsCommand}"
                      HorizontalAlignment="Left" Margin="0,0,0,2" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Classes="card" Grid.Row="3" Margin="0,0,0,16">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Items" />
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      VerticalScrollBarVisibility="Visible" x:CompileBindings="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Items" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="90" />
                <DataGridTextColumn Header="Purchased" Binding="{Binding Purchased}" Width="90" />
                <DataGridTextColumn Header="In Stock" Binding="{Binding InStock}" Width="90" />
                <DataGridTextColumn Header="Total kg" Binding="{Binding TotalWeightText}" Width="110" />
                <!-- What a piece costs now: what it was bought for, plus the share of the container's
                     expenses this item's weight carries. It is the figure a sale is costed at, so the
                     freight is not left out of profit. -->
                <DataGridTextColumn Header="Cost each" Binding="{Binding UnitCostText}" Width="130" />
                <DataGridTextColumn Header="Of which freight" Binding="{Binding FreightText}" Width="170" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <Border Classes="card" Margin="0,0,0,16">
        <Expander Header="Add item" IsExpanded="{Binding ShowItemForm}" HorizontalAlignment="Stretch">
          <StackPanel Margin="0,12,0,0" HorizontalAlignment="Stretch">
            <TextBlock Classes="label" Text="Name" />
            <TextBox Text="{Binding GoodsName}" HorizontalAlignment="Stretch" />
            <Grid ColumnDefinitions="*,*,*,*">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="label" Text="SKU / quality (optional)" />
                <TextBox Text="{Binding GoodsSku}" Watermark="optional" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Classes="label" Text="Qty" />
                <NumericUpDown Value="{Binding GoodsQty}" Minimum="0" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Classes="label" Text="Price" />
                <NumericUpDown Value="{Binding GoodsCost}" Minimum="0" HorizontalAlignment="Stretch" />
                <TextBlock Classes="words" Text="{Binding GoodsCost, Converter={StaticResource WordsConv}}" />
              </StackPanel>
              <!-- What one piece weighs, as on the order sheet: the lot's weight in all is this times how
                   many were landed, and that is what the shipment's expenses are divided by. -->
              <StackPanel Grid.Column="3">
                <TextBlock Classes="label" Text="Kg each" />
                <NumericUpDown Value="{Binding GoodsWeight}" Minimum="0" Increment="0.001"
                               FormatString="#,##0.###" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="label" Text="In stock (when editing)" />
            <NumericUpDown Value="{Binding GoodsInStock}" Minimum="0" HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Add" Command="{Binding AddGoodsCommand}" />
              <Button Content="Save item" Command="{Binding SaveGoodsCommand}" />
              <Button Classes="danger" Content="Delete" Command="{Binding DeleteGoodsCommand}" />
            </StackPanel>
          </StackPanel>
        </Expander>
      </Border>

      <Border Classes="card">
        <Expander Header="Expenses" HorizontalAlignment="Stretch">
          <StackPanel Margin="0,12,0,0" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,140,120,Auto,Auto,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="label" Text="Category" />
                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding ExpenseCategory}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Classes="label" Text="Amount" />
                <NumericUpDown Value="{Binding ExpenseAmount}" Minimum="0" />
                <TextBlock Classes="words" Text="{Binding ExpenseAmount, Converter={StaticResource WordsConv}}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Classes="label" Text="Currency" />
                <ComboBox ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding ExpenseCurrency}" />
              </StackPanel>
              <Button Grid.Column="3" Classes="primary" Content="Add" Command="{Binding AddExpenseCommand}"
                      VerticalAlignment="Bottom" Margin="0,0,8,12" />
              <Button Grid.Column="4" Content="Save" Command="{Binding SaveExpenseCommand}"
                      VerticalAlignment="Bottom" Margin="0,0,8,12" />
              <Button Grid.Column="5" Classes="danger" Content="Remove" Command="{Binding RemoveExpenseCommand}"
                      VerticalAlignment="Bottom" Margin="0,0,0,12" />
            </Grid>
            <!-- What a yen figure comes to in rupees, said before it is written, so no one has to multiply
                 in their head to know what will land in the costs. -->
            <TextBlock Classes="words" TextWrapping="Wrap" IsVisible="{Binding ShowExpensePreview}"
                       Text="{Binding ExpensePreview}" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}" x:CompileBindings="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" Width="120" />
                <DataGridTextColumn Header="What" Binding="{Binding Category}" Width="*" />
                <!-- Printed in the figure's own voice, paisa and all, so the lines under an expense total
                     add back to it on the screen. -->
                <DataGridTemplateColumn Header="Amount" Width="140">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Amount, Converter={StaticResource MoneyConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Empty on a rupee line: there is nothing to explain about it. -->
                <DataGridTextColumn Header="Entered as" Binding="{Binding SourceText}" Width="260" />
              </DataGrid.Columns>
            </DataGrid>
            <!-- What the expenses do to the costs, in the same figures the costs were written from. -->
            <TextBlock Classes="words" TextWrapping="Wrap" IsVisible="{Binding ShowExpenseTape}"
                       Text="{Binding ExpenseTape}" Margin="0,10,0,0" />
          </StackPanel>
        </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
