<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.CustomerDetailView"
             x:DataType="vm:CustomerDetailViewModel">
  <StackPanel>
    <DockPanel LastChildFill="True" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0"
                  VerticalAlignment="Top">
        <Button Content="Print khata" Command="{Binding PrintKhataCommand}" />
        <Button Content="WhatsApp" Command="{Binding WhatsAppCommand}" />
        <Button Content="Back" Command="{Binding BackCommand}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{Binding Heading}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>

    <Grid ColumnDefinitions="*,*">
      <Border Classes="statcard">
        <StackPanel>
          <TextBlock Classes="label" Text="They owe you" />
          <TextBlock Classes="stat" Text="{Binding BalanceText}" />
        </StackPanel>
      </Border>
      <Border Classes="statcard" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Classes="label" Text="Collected so far" />
          <TextBlock Classes="stat ok" Text="{Binding ReceivedText}" />
          <TextBlock Classes="label" Text="Remaining" Margin="0,8,0,0" />
          <TextBlock Classes="stat" Text="{Binding BalanceText}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Receive money" />
        <TextBlock Classes="label" Text="Against invoice (optional)" />
        <ComboBox ItemsSource="{Binding Unpaid}" SelectedItem="{Binding SelectedUnpaid}" />
        <Grid ColumnDefinitions="160,160,*,Auto">
          <NumericUpDown Value="{Binding PayAmount}" Minimum="0" Margin="0,0,8,12" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Methods}" SelectedItem="{Binding PayMethod}" Margin="0,0,8,12" />
          <TextBox Grid.Column="2" Text="{Binding PayNotes}" Watermark="Note (optional)" Margin="0,0,8,12" />
          <Button Grid.Column="3" Classes="primary" Content="Record" Command="{Binding ReceiveCommand}" Margin="0,0,0,12" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Opening balance (before this software)" />
        <Grid ColumnDefinitions="200,Auto">
          <NumericUpDown Value="{Binding OpeningAmount}" Margin="0,0,8,12" />
          <Button Grid.Column="1" Content="Save opening" Command="{Binding SaveOpeningCommand}" Margin="0,0,0,12" />
        </Grid>
        <TextBlock Classes="muted" FontSize="12" Text="Positive = they already owed you. Negative = they had an advance." />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Payments  —  select one to delete a duplicate" />
        <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" Width="120" />
            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="120" />
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs {0:N0}'}" Width="140" />
            <DataGridTextColumn Header="Invoice" Binding="{Binding SaleId}" Width="80" />
            <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <Button Classes="danger" Content="Delete payment" Command="{Binding DeletePaymentCommand}"
                HorizontalAlignment="Left" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Invoices  —  double-click to see items and containers" />
        <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                  DoubleTapped="OnInvoiceDoubleTap" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110" />
            <DataGridTextColumn Header="Containers" Binding="{Binding Containers}" Width="*" />
            <DataGridTextColumn Header="Bill" Binding="{Binding TotalText}" Width="120" />
            <DataGridTextColumn Header="Credit" Binding="{Binding CreditText}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Khata" />
        <DataGrid ItemsSource="{Binding Ledger}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110" />
            <DataGridTextColumn Header="Particulars" Binding="{Binding Description}" Width="*" />
            <DataGridTextColumn Header="Sold" Binding="{Binding DebitText}" Width="120" />
            <DataGridTextColumn Header="Received" Binding="{Binding CreditText}" Width="120" />
            <DataGridTextColumn Header="Balance" Binding="{Binding RunningText}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
