<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.CustomerDetailView"
             x:DataType="vm:CustomerDetailViewModel">
  <StackPanel>
    <DockPanel LastChildFill="True" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0"
                  VerticalAlignment="Top">
        <Button Content="Print ledger" Command="{Binding PrintLedgerCommand}" />
        <Button Content="WhatsApp" Command="{Binding WhatsAppCommand}" />
        <Button Content="Back" Command="{Binding BackCommand}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{Binding Heading}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>

    <Grid ColumnDefinitions="*,*">
      <Border Classes="statcard" Margin="0,0,8,16">
        <StackPanel>
          <TextBlock Classes="label" Text="They owe you" />
          <TextBlock Classes="stat" Text="{Binding BalanceText}" />
        </StackPanel>
      </Border>
      <Border Classes="statcard" Grid.Column="1" Margin="8,0,0,16">
        <StackPanel>
          <TextBlock Classes="label" Text="Collected so far" />
          <TextBlock Classes="stat ok" Text="{Binding ReceivedText}" />
          <TextBlock Classes="label" Text="Remaining" Margin="0,10,0,6" />
          <TextBlock Classes="stat" Text="{Binding BalanceText}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Receive money" />
        <TextBlock Classes="label" Text="Against invoice (optional)" />
        <ComboBox ItemsSource="{Binding Unpaid}" SelectedItem="{Binding SelectedUnpaid}" />
        <!-- The picker takes an Auto column and is left to its own width, as everywhere else in the app:
             a date box clipped to a column the page chose is a date that gets recorded wrong. -->
        <Grid ColumnDefinitions="Auto,160,150,*,Auto">
          <DatePicker SelectedDate="{Binding PayDate}" Margin="0,0,8,12" />
          <NumericUpDown Grid.Column="1" Value="{Binding PayAmount}" Minimum="0" Margin="0,0,8,12" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding Methods}" SelectedItem="{Binding PayMethod}" Margin="0,0,8,12" />
          <TextBox Grid.Column="3" Text="{Binding PayNotes}" Watermark="Note (optional)" Margin="0,0,8,12" />
          <Button Grid.Column="4" Classes="primary" Content="Record" Command="{Binding ReceiveCommand}" Margin="0,0,0,12" />
        </Grid>
        <TextBlock Classes="words" Text="{Binding PayAmount, Converter={StaticResource WordsConv}}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Opening balance (before this software)" />
        <Grid ColumnDefinitions="200,Auto">
          <NumericUpDown Value="{Binding OpeningAmount}" Margin="0,0,8,12" />
          <Button Grid.Column="1" Content="Save opening" Command="{Binding SaveOpeningCommand}" Margin="0,0,0,12" />
        </Grid>
        <TextBlock Classes="words" Text="{Binding OpeningAmount, Converter={StaticResource WordsConv}}" />
        <TextBlock Classes="muted" FontSize="12" Text="Positive = they already owed you. Negative = they had an advance." />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Payments  —  select one to delete a duplicate" />
        <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" Width="120" />
            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="120" />
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs {0:N0}'}" Width="140" />
            <DataGridTextColumn Header="Invoice" Binding="{Binding SaleId}" Width="80" />
            <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <Button Classes="danger" Content="Delete payment" Command="{Binding DeletePaymentCommand}"
                HorizontalAlignment="Left" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Invoices" />
        <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                  DoubleTapped="OnInvoiceDoubleTap" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110" />
            <DataGridTextColumn Header="Containers" Binding="{Binding Containers}" Width="*" />
            <DataGridTextColumn Header="Bill" Binding="{Binding TotalText}" Width="120" />
            <DataGridTextColumn Header="Credit" Binding="{Binding CreditText}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Ledger" />
        <DataGrid ItemsSource="{Binding Ledger}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="No." Binding="{Binding Step}" Width="70" />
            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110" />
            <DataGridTextColumn Header="Particulars" Binding="{Binding Description}" Width="*" />
            <DataGridTemplateColumn Header="Sold" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding SoldText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Returned" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ReturnedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Received" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ReceivedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Paid out" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PaidOutText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Balance" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RunningText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
