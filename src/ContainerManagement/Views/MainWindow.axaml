<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ContainerManagement.ViewModels"
        xmlns:views="using:ContainerManagement.Views"
        x:Class="ContainerManagement.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding BrandName}"
        Icon="/Assets/logo.png"
        Width="1200" Height="780"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
  <Grid>
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E6E4DE" BorderThickness="0,1,0,0" Padding="24,10">
        <TextBlock Text="{Binding Status}" Classes.bad="{Binding IsError}" FontSize="13" Foreground="#6B7280" />
      </Border>

      <Border Width="216" Background="{StaticResource NavyBrush}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="20,24,20,8">
            <Border CornerRadius="12" ClipToBounds="True" Width="56" Height="56"
                    Background="#1B2A4A" HorizontalAlignment="Left" Margin="0,0,0,12">
              <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock Text="{Binding BrandName}" FontSize="20" FontWeight="SemiBold"
                       Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12" />
          </StackPanel>
          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNav}"
                   Background="Transparent"
                   Margin="10,4,10,16"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="#C9D3E4" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="Transparent" />
              </Style>
              <Style Selector="ListBoxItem:pointerover">
                <Setter Property="Background" Value="#2C3F66" />
              </Style>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Background" Value="#2C3F66" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
              <Style Selector="ListBoxItem:selected TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <views:PageHost Page="{Binding CurrentPage}" />
    </DockPanel>

    <Border Background="#991B2A4A" IsVisible="{Binding NeedsPin}">
      <Border Classes="dialog" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Classes="h1" Text="{Binding BrandName}" />
          <TextBlock Classes="muted" Text="{Binding PinHint}" Margin="0,0,0,16" />
          <TextBlock Classes="label" Text="PIN" />
          <TextBox Text="{Binding PinInput}" PasswordChar="•" />
          <Button Classes="gold" Content="Unlock" Command="{Binding UnlockCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#991B2A4A" IsVisible="{Binding NeedsActivation}">
      <Border Classes="dialog" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Classes="h1" Text="Activate ProBooks" />
          <TextBlock Classes="muted" Text="{Binding LicenseHint}" TextWrapping="Wrap" Margin="0,0,0,16" />
          <TextBlock Classes="label" Text="License key" />
          <TextBox Text="{Binding LicenseKeyInput}" Watermark="CK1...." TextWrapping="Wrap" />
          <Button Classes="gold" Content="Activate" Command="{Binding ActivateCommand}" HorizontalAlignment="Left" />

          <Button Content="I am the seller — issue a license" Command="{Binding ToggleSellerFormCommand}"
                  HorizontalAlignment="Left" Margin="0,16,0,0" />
          <StackPanel IsVisible="{Binding ShowSellerForm}" Margin="0,16,0,0">
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Type the seller PIN and the customer's business name. The window is renamed to that shop. This is a lifetime license. You can pause this copy later if they do not pay." />
            <TextBlock Classes="label" Text="Seller PIN" />
            <TextBox Text="{Binding VendorPin}" PasswordChar="•" />
            <TextBlock Classes="label" Text="Business name" />
            <TextBox Text="{Binding IssueBusinessName}" Watermark="e.g. Ahmad Traders" />
            <Button Classes="primary" Content="Issue and activate" Command="{Binding IssueLicenseCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Classes="label" Text="Key (copy for a second PC)" Margin="0,12,0,6" />
            <TextBox Text="{Binding IssuedKey}" IsReadOnly="True" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#991B2A4A" IsVisible="{Binding NeedsLicenseLock}">
      <Border Classes="dialog" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Classes="h1" Text="This copy is paused" />
          <TextBlock Classes="muted" Text="{Binding LockReason}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,16"
                     Text="This screen updates by itself. You do not need to reinstall or pull new code." />
          <Button Classes="gold" Content="Check again" Command="{Binding CheckLicenseCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
