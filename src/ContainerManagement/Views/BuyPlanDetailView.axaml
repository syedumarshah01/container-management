<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.BuyPlanDetailView"
             x:DataType="vm:BuyPlanDetailViewModel">
  <UserControl.Styles>
    <Style Selector="DataGrid ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" Classes="page"
                AllowAutoHide="False"
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

      <!-- one line: name, rate, expense, and the two actions, all on the same label/box rhythm -->
      <Grid ColumnDefinitions="2*,*,*,Auto" Margin="0,0,0,12">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Classes="label" Text="SHEET NAME" />
          <TextBox Text="{Binding Title}" Watermark="e.g. April — Yiwu electronics"
                   IsEnabled="{Binding IsOwner}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Classes="label" Text="RS FOR 1 YEN" />
          <NumericUpDown Value="{Binding YenRate}" Minimum="0" Increment="0.01" FormatString="#,##0.####"
                         IsEnabled="{Binding IsOwner}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,12,0">
          <TextBlock Classes="label" Text="TOTAL EXPENSE (RS)" />
          <NumericUpDown Value="{Binding ExpensePkr}" Minimum="0" IsEnabled="{Binding IsOwner}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"
                    Margin="0,0,0,12">
          <Button Content="Back" Command="{Binding BackCommand}" MinWidth="90" />
          <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="90" IsVisible="{Binding IsOwner}"
                  Classes.gold="{Binding IsDirty}" />
        </StackPanel>
      </Grid>

      <Border Classes="card" Padding="22,14">
        <Grid ColumnDefinitions="2*,2*,2*,2*,2*,3*,2*">
          <StackPanel>
            <TextBlock Classes="label" Text="COST ¥" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CostYenText}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="COST Rs" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CostPkrText}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="+ EXPENSE" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ExpenseText}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="label" Text="= ALL IN" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SpendText}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="label" Text="ALL SOLD FOR" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SaleText}" />
          </StackPanel>
          <StackPanel Grid.Column="5">
            <TextBlock Classes="label" Text="PROFIT" />
            <TextBlock FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ProfitText}"
                       Classes.ok="{Binding ProfitGood}" Classes.bad="{Binding !ProfitGood}" />
            <TextBlock Classes="muted" Text="{Binding MarginText}" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Classes="label" Text="WEIGHT" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding WeightText}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="h2" Text="{Binding CountText}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsVisible="{Binding HasSelection}">
              <Button Content="Update row" Command="{Binding UpdateLineCommand}" MinWidth="110" />
              <Button Classes="danger" Content="Remove" Command="{Binding RemoveLineCommand}" MinWidth="90" />
            </StackPanel>
          </Grid>

          <DataGrid Classes="tall" ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected}"
                    VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                    x:CompileBindings="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Item" Binding="{Binding ItemNameText}" Width="340" />
              <DataGridTextColumn Header="Qty" Binding="{Binding QuantityText}" Width="95" />
              <DataGridTextColumn Header="¥ each" Binding="{Binding UnitCostYenText}" Width="125" />
              <DataGridTextColumn Header="Total ¥" Binding="{Binding CostYenText}" Width="155" />
              <DataGridTextColumn Header="Cost each" Binding="{Binding CostPerPiecePkrText}" Width="145" />
              <DataGridTextColumn Header="Total cost" Binding="{Binding CostPkrText}" Width="165" />
              <DataGridTextColumn Header="kg each" Binding="{Binding UnitWeightText}" Width="115" />
              <DataGridTextColumn Header="Total kg" Binding="{Binding TotalWeightText}" Width="135" />
              <DataGridTextColumn Header="Sells each" Binding="{Binding SalePriceText}" Width="145" />
              <DataGridTextColumn Header="Total sells" Binding="{Binding SaleTotalText}" Width="165" />
              <DataGridTemplateColumn Header="Profit" Width="165">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ProfitText}" Margin="10,0" VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Classes.ok="{Binding ProfitIsGood}" Classes.bad="{Binding !ProfitIsGood}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <Border Height="1" Background="#E6E4DE" Margin="0,16,0,14" />

          <Grid ColumnDefinitions="3*,*,*,*,*,Auto" IsVisible="{Binding IsOwner}">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Classes="label" Text="ITEM" />
              <TextBox Text="{Binding ItemName}" Watermark="name as on the invoice" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="QTY" />
              <NumericUpDown Value="{Binding Qty}" Minimum="0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="¥ EACH" />
              <NumericUpDown Value="{Binding UnitCostYen}" Minimum="0" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="KG EACH" />
              <NumericUpDown Value="{Binding UnitWeightKg}" Minimum="0" Increment="0.001" FormatString="#,##0.###" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="SELLS Rs EACH" />
              <NumericUpDown Value="{Binding SalePricePkr}" Minimum="0" />
            </StackPanel>
            <Button Grid.Column="5" Classes="primary" Content="Add row" Command="{Binding AddLineCommand}"
                    VerticalAlignment="Bottom" Margin="0,0,0,12" MinWidth="100" />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
