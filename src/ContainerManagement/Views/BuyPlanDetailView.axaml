<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.BuyPlanDetailView"
             x:DataType="vm:BuyPlanDetailViewModel">
  <UserControl.Styles>
    <Style Selector="DataGrid ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" Classes="page"
                AllowAutoHide="False"
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

      <!-- one line: the sheet's name, the rate everything yen is taken at, and the two actions, all on the
           same label/box rhythm. The expense figure is not here: it is typed a bill at a time below, and the
           sheet adds those rows up. -->
      <Grid ColumnDefinitions="2*,*,Auto" Margin="0,0,0,12">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Classes="label" Text="SHEET NAME" />
          <TextBox Text="{Binding Title}" Watermark="e.g. April — Yiwu electronics"
                   IsEnabled="{Binding IsOwner}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Classes="label" Text="RS FOR 1 YEN" />
          <NumericUpDown Value="{Binding YenRate}" Minimum="0" Increment="0.01" FormatString="#,##0.####"
                         IsEnabled="{Binding IsOwner}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"
                    Margin="0,0,0,12">
          <Button Content="Back" Command="{Binding BackCommand}" MinWidth="90" />
          <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="90" IsVisible="{Binding IsOwner}"
                  Classes.gold="{Binding IsDirty}" />
        </StackPanel>
      </Grid>

      <Border Classes="card" Padding="22,14">
        <Grid ColumnDefinitions="2*,2*,2*,2*,2*,3*,2*">
          <StackPanel>
            <TextBlock Classes="label" Text="COST ¥" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CostYenText}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="COST Rs" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CostPkrText}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="+ EXPENSE" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ExpenseText}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="label" Text="= ALL IN" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SpendText}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="label" Text="ALL SOLD FOR" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SaleText}" />
          </StackPanel>
          <StackPanel Grid.Column="5">
            <TextBlock Classes="label" Text="PROFIT" />
            <TextBlock FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ProfitText}"
                       Classes.ok="{Binding ProfitGood}" Classes.bad="{Binding !ProfitGood}" />
            <TextBlock Classes="muted" Text="{Binding MarginText}" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Classes="label" Text="WEIGHT" />
            <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding WeightText}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="h2" Text="{Binding CountText}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsVisible="{Binding HasSelection}">
              <Button Content="Update row" Command="{Binding UpdateLineCommand}" MinWidth="110" />
              <Button Classes="danger" Content="Remove" Command="{Binding RemoveLineCommand}" MinWidth="90" />
            </StackPanel>
          </Grid>

          <DataGrid Classes="tall" ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected}"
                    VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                    x:CompileBindings="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Item" Binding="{Binding ItemNameText}" Width="340" />
              <DataGridTextColumn Header="Qty" Binding="{Binding QuantityText}" Width="95" />
              <DataGridTextColumn Header="¥ each" Binding="{Binding UnitCostYenText}" Width="125" />
              <DataGridTextColumn Header="Total ¥" Binding="{Binding CostYenText}" Width="155" />
              <DataGridTextColumn Header="Cost each" Binding="{Binding CostPerPiecePkrText}" Width="145" />
              <DataGridTextColumn Header="Total cost" Binding="{Binding CostPkrText}" Width="165" />
              <DataGridTextColumn Header="kg each" Binding="{Binding UnitWeightText}" Width="115" />
              <DataGridTextColumn Header="Total kg" Binding="{Binding TotalWeightText}" Width="135" />
              <DataGridTextColumn Header="Sells each" Binding="{Binding SalePriceText}" Width="145" />
              <DataGridTextColumn Header="Total sells" Binding="{Binding SaleTotalText}" Width="165" />
              <DataGridTemplateColumn Header="Profit" Width="165">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ProfitText}" Margin="10,0" VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Classes.ok="{Binding ProfitIsGood}" Classes.bad="{Binding !ProfitIsGood}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <Border Height="1" Background="#E6E4DE" Margin="0,16,0,14" />

          <Grid ColumnDefinitions="3*,*,*,*,*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding IsOwner}">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Classes="label" Text="ITEM" />
              <TextBox Text="{Binding ItemName}" Watermark="name as on the invoice" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="QTY" />
              <NumericUpDown Value="{Binding Qty}" Minimum="0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="¥ EACH" />
              <NumericUpDown Value="{Binding UnitCostYen}" Minimum="0" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="KG EACH" />
              <NumericUpDown Value="{Binding UnitWeightKg}" Minimum="0" Increment="0.001" FormatString="#,##0.###" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="SELLS Rs EACH" />
              <NumericUpDown Value="{Binding SalePricePkr}" Minimum="0" />
            </StackPanel>
            <TextBlock Classes="words" Grid.Row="1" Grid.Column="4" Text="{Binding SalePricePkr, Converter={StaticResource WordsConv}}" />
            <Button Grid.Column="5" Grid.Row="0" Classes="primary" Content="Add row"
                    Command="{Binding AddLineCommand}" VerticalAlignment="Bottom"
                    Margin="0,0,0,12" MinWidth="100" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" Margin="0,16,0,0">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="h2" Text="Expenses" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsVisible="{Binding HasExpenseSelection}">
              <Button Content="Update row" Command="{Binding UpdateExpenseCommand}" MinWidth="110" />
              <Button Classes="danger" Content="Remove" Command="{Binding RemoveExpenseCommand}" MinWidth="90" />
            </StackPanel>
          </Grid>

          <DataGrid ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}"
                    VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                    x:CompileBindings="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="What it was for" Binding="{Binding DescriptionText}" Width="420" />
              <!-- The rupees the sheet adds, with the bill as it was written under it: the yen figure and the
                   rate it was taken at, so a rupee total is never the only thing left of a foreign invoice. -->
              <DataGridTemplateColumn Header="Rs on the sheet" Width="260">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Classes="words" TextWrapping="Wrap" IsVisible="{Binding ShowExpenseTape}"
                     Text="{Binding ExpenseTape}" Margin="0,12,0,0" />

          <Border Height="1" Background="#E6E4DE" Margin="0,16,0,14" IsVisible="{Binding IsOwner}" />

          <Grid ColumnDefinitions="3*,*,*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding IsOwner}">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Classes="label" Text="WHAT IT WAS FOR" />
              <TextBox Text="{Binding ExpenseDescription}" Watermark="sea freight, customs, clearing, labour ..." />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="AMOUNT" />
              <NumericUpDown Value="{Binding ExpenseAmount}" Minimum="0" />
              <TextBlock Classes="words" Text="{Binding ExpenseAmount, Converter={StaticResource WordsConv}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="CURRENCY" />
              <ComboBox ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding ExpenseCurrency}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
            <Button Grid.Column="3" Classes="primary" Content="Add bill" Command="{Binding AddExpenseCommand}"
                    VerticalAlignment="Bottom" Margin="0,0,0,12" MinWidth="100" />
            <!-- The rate a yen bill is taken at, next to the figure it converts, with the answer under it -
                 and it is this row's own rate: the box at the top prices the goods, and clicking an old bill
                 should not quietly re-price the sheet. -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="14"
                        IsVisible="{Binding ExpenseIsYen}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="RS FOR 1 YEN" VerticalAlignment="Center" Margin="0" />
                <NumericUpDown Width="130" Minimum="0" Increment="0.0001" FormatString="#,##0.######"
                               Value="{Binding ExpenseRate}" />
              </StackPanel>
              <TextBlock Classes="words" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center"
                         IsVisible="{Binding ShowExpensePreview}" Text="{Binding ExpensePreview}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
