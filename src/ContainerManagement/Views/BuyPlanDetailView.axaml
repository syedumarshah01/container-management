<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.BuyPlanDetailView"
             x:DataType="vm:BuyPlanDetailViewModel">
  <UserControl.Styles>
    <Style Selector="DataGrid ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" Classes="page"
                AllowAutoHide="False"
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

      <Grid ColumnDefinitions="*,190,190,Auto" Margin="0,0,0,12">
        <TextBox Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Padding="0,6"
                 Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#E6E4DE"
                 Watermark="Name this order sheet" IsEnabled="{Binding IsOwner}" Margin="0,0,16,0" />
        <StackPanel Grid.Column="1" Margin="0,0,16,0">
          <TextBlock Classes="label" Text="Rs for 1 yen" />
          <NumericUpDown Value="{Binding YenRate}" Minimum="0" Increment="0.5"
                         FontSize="17" FontWeight="SemiBold" IsEnabled="{Binding IsOwner}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,16,0">
          <TextBlock Classes="label" Text="Total expense (Rs)" />
          <NumericUpDown Value="{Binding ExpensePkr}" Minimum="0"
                         FontSize="17" FontWeight="SemiBold" IsEnabled="{Binding IsOwner}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button Content="Back" Command="{Binding BackCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding IsOwner}"
                  Classes.gold="{Binding IsDirty}" />
        </StackPanel>
      </Grid>

      <Border Classes="card" Padding="22,14">
        <Grid ColumnDefinitions="2*,2*,2*,2*,2*,3*,2*">
          <StackPanel>
            <TextBlock Classes="label" Text="COST ¥" />
            <TextBlock Classes="cell" Text="{Binding CostYenText}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="COST Rs" />
            <TextBlock Classes="cell" Text="{Binding CostPkrText}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="+ EXPENSE" />
            <TextBlock Classes="cell" Text="{Binding ExpenseText}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="label" Text="= ALL IN" />
            <TextBlock Classes="cell" Text="{Binding SpendText}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="label" Text="ALL SOLD FOR" />
            <TextBlock Classes="cell" Text="{Binding SaleText}" />
          </StackPanel>
          <StackPanel Grid.Column="5">
            <TextBlock Classes="label" Text="PROFIT" />
            <TextBlock Classes="cell" FontSize="23" Text="{Binding ProfitText}"
                       Classes.ok="{Binding ProfitGood}" Classes.bad="{Binding !ProfitGood}" />
            <TextBlock Classes="muted" Text="{Binding MarginText}" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Classes="label" Text="WEIGHT" />
            <TextBlock Classes="cell" Text="{Binding WeightText}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="h2" Text="{Binding CountText}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSelection}">
              <Button Content="Update row" Command="{Binding UpdateLineCommand}" />
              <Button Classes="danger" Content="Remove" Command="{Binding RemoveLineCommand}" />
            </StackPanel>
          </Grid>

          <DataGrid Classes="tall" ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected}"
                    VerticalScrollBarVisibility="Visible" x:CompileBindings="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Item" Binding="{Binding ItemNameText}" Width="*" />
              <DataGridTextColumn Header="Qty" Binding="{Binding QuantityText}" Width="90" />
              <DataGridTextColumn Header="¥ each" Binding="{Binding UnitCostYenText}" Width="110" />
              <DataGridTextColumn Header="Total ¥" Binding="{Binding CostYenText}" Width="140" />
              <DataGridTextColumn Header="Rs cost" Binding="{Binding CostPkrText}" Width="150" />
              <DataGridTextColumn Header="kg each" Binding="{Binding UnitWeightText}" Width="100" />
              <DataGridTextColumn Header="Total kg" Binding="{Binding TotalWeightText}" Width="110" />
              <DataGridTextColumn Header="Rs each" Binding="{Binding SalePriceText}" Width="130" />
              <DataGridTextColumn Header="Sells for" Binding="{Binding SaleTotalText}" Width="150" />
              <DataGridTemplateColumn Header="Profit" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ProfitText}" Margin="10,0" VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Classes.ok="{Binding ProfitIsGood}" Classes.bad="{Binding !ProfitIsGood}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <Border Height="1" Background="#E6E4DE" Margin="0,16,0,14" />

          <Grid ColumnDefinitions="3*,*,*,*,*,Auto" IsVisible="{Binding IsOwner}">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Classes="label" Text="ITEM" />
              <TextBox Text="{Binding ItemName}" Watermark="name as on the invoice" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="QTY" />
              <NumericUpDown Value="{Binding Qty}" Minimum="0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="¥ EACH" />
              <NumericUpDown Value="{Binding UnitCostYen}" Minimum="0" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="KG EACH" />
              <NumericUpDown Value="{Binding UnitWeightKg}" Minimum="0" Increment="0.01" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,10,0">
              <TextBlock Classes="label" Text="SELL Rs EACH" />
              <NumericUpDown Value="{Binding SalePricePkr}" Minimum="0" />
            </StackPanel>
            <Button Grid.Column="5" Classes="primary" Content="Add row" Command="{Binding AddLineCommand}"
                    VerticalAlignment="Bottom" />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
