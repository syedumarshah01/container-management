<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">
  <Grid RowDefinitions="Auto,Auto,*,220">
    <Grid ColumnDefinitions="*,280">
      <TextBlock Classes="h1" Text="Stock" />
      <TextBox Grid.Column="1" Text="{Binding Query}" Watermark="Search name, SKU, container"
               VerticalAlignment="Top" Margin="16,0,0,12" />
    </Grid>

    <Border Classes="statcard" Grid.Row="1" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Classes="label" Text="Total stock value" />
        <TextBlock Classes="stat" Text="{Binding TotalValue}" />
        <TextBlock Classes="muted" Text="{Binding LowHint}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <Border Classes="card" Grid.Row="2" Margin="0,0,0,16">
      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" x:CompileBindings="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" />
          <DataGridTextColumn Header="SKU" Binding="{Binding SkuText}" Width="90" />
          <DataGridTextColumn Header="In Stock" Binding="{Binding InStockText}" Width="110" />
          <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="130" />
          <DataGridTextColumn Header="Which container" Binding="{Binding LotsText}" Width="160" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Classes="card" Grid.Row="3" Margin="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding LotsHeading}" TextWrapping="Wrap" />
        <DataGrid ItemsSource="{Binding SelectedLots}" SelectedItem="{Binding SelectedLot}"
                  IsVisible="{Binding HasSelectedLots}" DoubleTapped="OnLotDoubleTap"
                  x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Container" Binding="{Binding ContainerTitle}" Width="*" />
            <DataGridTextColumn Header="In Stock" Binding="{Binding RemainingText}" Width="110" />
            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
