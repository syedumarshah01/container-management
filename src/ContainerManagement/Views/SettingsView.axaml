<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Settings" Margin="0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Image Source="{Binding BrandArt}" Height="16" HorizontalAlignment="Right"
               IsVisible="{Binding HasBrandArt}" />
        <StackPanel IsVisible="{Binding !HasBrandArt}">
          <TextBlock Classes="brand" Text="SYNTAXIA" HorizontalAlignment="Right" FontSize="12"
                     LetterSpacing="2.4" />
          <TextBlock Classes="brandTag" Text="SOLUTIONS" HorizontalAlignment="Right" Margin="0,2,0,0"
                     FontSize="8" LetterSpacing="3.2" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Shop on invoices" />
        <TextBlock Classes="label" Text="Company name (from license)" />
        <TextBox Text="{Binding CompanyName}" IsReadOnly="{Binding CompanyNameLocked}" />
        <TextBlock Classes="label" Text="License id" />
        <TextBox Text="{Binding LicenseId}" IsReadOnly="True" />
        <TextBlock Classes="label" Text="License key (for a second PC)" />
        <TextBox Text="{Binding LicenseKey}" IsReadOnly="True" TextWrapping="Wrap" />
        <TextBlock Classes="label" Text="Phone" />
        <TextBox Text="{Binding Phone}" />
        <TextBlock Classes="label" Text="Address" />
        <TextBox Text="{Binding Address}" />
        <TextBlock Classes="label" Text="WhatsApp message" />
        <TextBox Text="{Binding WhatsAppMessage}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Empty, the book writes the message off the customer's ledger. What you type goes as you typed it." />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding ShareTokens}" />
        <Grid ColumnDefinitions="*,*">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Classes="label" Text="Low stock at or below" />
            <NumericUpDown Value="{Binding LowStock}" Minimum="0" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="Default credit days" />
            <NumericUpDown Value="{Binding DueDays}" Minimum="0" />
          </StackPanel>
        </Grid>
        <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="PIN" />
        <TextBlock Classes="muted" Text="{Binding PinNote}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Classes="label" Text="Owner PIN (costs, restore, wipe, settings)" />
        <TextBox Text="{Binding OwnerPin}" PasswordChar="•" />
        <TextBlock Classes="label" Text="Staff PIN (sell and collect only)" />
        <TextBox Text="{Binding StaffPin}" PasswordChar="•" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Save PINs" Command="{Binding SaveCommand}" />
          <Button Content="Clear PINs" Command="{Binding ClearPinsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding ShowWipeDemo}">
      <StackPanel>
        <TextBlock Classes="h2" Text="Go live" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Wipes demo containers and customers. Walk-in / Cash stays. A backup is taken first. Use this once when you start real books." />
        <Button Classes="danger" Content="Wipe demo data" Command="{Binding WipeDemoCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Updates" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Asks the branch this book is built from what is waiting, then builds it here. Your books are not part of an update - they are backed up first, and nothing else in the data folder is opened." />
        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,10,0,0">
          <Button Content="Check for updates" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding !UpdateBusy}" />
          <Button Grid.Column="1" Classes="primary" Content="Update now" Command="{Binding ApplyUpdateCommand}"
                  IsVisible="{Binding UpdateAvailable}" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding UpdateLine}" />
        <TextBlock FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0"
                   IsVisible="{Binding HasUpdateNotes}" Text="{Binding UpdateNotes}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Two computers" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Do not type on two PCs at the same time. Keep one PC as the books. Use Backup + Google Drive or a USB to copy the file. Restore on the other PC if this one dies." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
