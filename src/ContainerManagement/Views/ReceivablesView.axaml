<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContainerManagement.ViewModels"
             x:Class="ContainerManagement.Views.ReceivablesView"
             x:DataType="vm:ReceivablesViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="To collect" Margin="0" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding LotQuery}" Width="220" VerticalAlignment="Center"
               Watermark="Search container name or number" Margin="0,0,12,0" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding LotChoices}" SelectedItem="{Binding SelectedLot}"
                MinWidth="240" VerticalAlignment="Center" />
      <Button Grid.Column="3" Content="Print" Command="{Binding PrintCommand}"
              Margin="12,0,0,0" VerticalAlignment="Center" />
    </Grid>
    <Border Classes="statcard" Margin="0,0,0,4">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="label" Text="Customers owe in total" />
          <TextBlock Classes="stat bad" Text="{Binding Outstanding}" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" IsVisible="{Binding HasLot}">
          <TextBlock Classes="label" Text="{Binding LotLabel}" />
          <Grid ColumnDefinitions="Auto,Auto">
            <StackPanel Margin="0,0,40,0">
              <TextBlock Classes="label" Text="Collected" />
              <TextBlock Classes="stat ok" Text="{Binding LotCollected}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="label" Text="In the market" />
              <TextBlock Classes="stat" Text="{Binding LotFigure}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Classes="muted" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" IsVisible="{Binding HasLot}"
               Text="Both figures come from this container's bills; a customer's balance also holds advances and payouts, so the pair need not add to the amount owing on the left." />
    <Border Classes="card">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Classes="h2" Text="Customers" Margin="0" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Query}" Watermark="Search name or phone" Width="260"
                   VerticalAlignment="Center" Margin="0" />
        </Grid>
        <DataGrid ItemsSource="{Binding Due}" SelectedItem="{Binding Selected}"
                  DoubleTapped="OnDoubleTap" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="140" />
            <DataGridTextColumn Header="Last sale" Binding="{Binding LastSaleText}" Width="120" />
            <DataGridTextColumn Header="Last payment" Binding="{Binding LastPaymentText}" Width="130" />
            <DataGridTextColumn Header="Aging" Binding="{Binding Aging}" Width="110" />
            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceText}" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
